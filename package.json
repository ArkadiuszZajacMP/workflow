{
  "name": "workflow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,magenta \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "next dev --webpack --hostname 127.0.0.1",
    "dev:worker": "bash scripts/with-secrets.sh node --watch --import tsx src/worker/main.ts",
    "build": "next build --webpack",
    "start:worker": "bash scripts/with-secrets.sh node --import tsx src/worker/main.ts",
    "queue": "node --import tsx src/cli/main.ts",
    "smoke": "bash scripts/with-secrets.sh node --import tsx scripts/smoke.ts",
    "seed:demo": "node --import tsx scripts/seed-demo.ts",
    "db:generate": "drizzle-kit generate",
    "agent:build-image": "podman build -t workflow-agent:latest containers/agent",
    "test": "vitest run",
    "test:podman": "vitest run --config vitest.podman.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@base-ui/react": "^1.9.0",
    "@slack/web-api": "^8.2.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
